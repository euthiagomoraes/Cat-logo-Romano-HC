# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-ou-publishable

# ---------------------------------------------------------------------
# Integração com o ERP — NÃO coloque estes valores aqui nem na Vercel.
# São segredos do servidor, gravados só na Edge Function:
#   supabase secrets set ERP_API_URL=https://api.exemplo.com/v1
#   supabase secrets set ERP_API_KEY=...
#   supabase secrets set ERP_WEBHOOK_SECRET=...
# ---------------------------------------------------------------------